# Copy this file to .env (same directory) and fill in / verify the values below.
# DO NOT commit .env (already in .gitignore).
# Captured during Phase 0; consumed by every subsequent script and notebook.
#
# Pre-filled values reflect haris-crimsoncloud.in's PCAI sandbox.
# To run on a different cluster, override every value here OR set them in the shell
# before running scripts: `$env:PCAI_DOMAIN="other.example.com"; .\script.ps1`

# --- PCAI cluster identity ---
# PCAI_DOMAIN is the BASE domain — services live at subdomains:
#   home.${PCAI_DOMAIN}      → PCAI dashboard
#   kubeflow.${PCAI_DOMAIN}  → Kubeflow
#   keycloak.${PCAI_DOMAIN}  → SSO
#   <imported-app>.${PCAI_DOMAIN} → frameworks you Import via Tools & Frameworks
PCAI_DOMAIN=pcai2.genai2.hou
PCAI_HOME_URL=https://home.${PCAI_DOMAIN}
PCAI_KUBEFLOW_URL=https://kubeflow.${PCAI_DOMAIN}
OIDC_ISSUER=https://keycloak.${PCAI_DOMAIN}/realms/UA
OIDC_CLIENT_ID=ua-grant
PCAI_USERNAME=haris-crimsoncloud.in
# K8s namespace for everything you create (kubectl apply, MLIS deployment, etc.):
PROJECT_NAME=user-haris-crimsoncl-f7ced444
# Kubeflow profile namespace (sometimes differs from K8s namespace; URL ?ns= param uses this):
KUBEFLOW_NS=haris-crimsoncl-f7ced444

# --- In-cluster service endpoints (constants on PCAI 1.9) ---
S3_PROXY_URL=http://local-s3-service.ezdata-system.svc.cluster.local:30000
MLFLOW_TRACKING_URI=http://mlflow.mlflow.svc.cluster.local:5000

# --- Object store: using PCAI's local-s3 (no external MinIO needed) ---
# We create our own buckets inside local-s3 via boto3 — no UI Data Source step required.
# Endpoint above is what boto3 talks to; auth = JWT as access key, "s3" as secret.
S3_BUCKET=fraud-tabformer
S3_PREFIX_RAW=raw
S3_PREFIX_CURATED=curated
S3_PREFIX_GNN=gnn
S3_PREFIX_MODELS=models

# --- EzPresto JDBC (for Phase A2 federation queries from external tools) ---
# Get this from PCAI UI > Administration > Settings > Configurations tab > JDBC Endpoint section.
# Public ingress format on PCAI 1.9 looks like: jdbc:presto://ezpresto.<PCAI_DOMAIN>:443
EZPRESTO_JDBC_URL=jdbc:presto://ezpresto.${PCAI_DOMAIN}:443
EZPRESTO_USER=${PCAI_USERNAME}
# Password is fetched at runtime from PCAI per the "Getting the Password for EzPresto" doc page.

# --- NGC (NVIDIA Container Registry) ---
# Needed in Phase B to pull nvcr.io/nvidia/cugraph/financial-fraud-training:2.0.0
NGC_API_KEY=                      # from https://ngc.nvidia.com/setup/api-key
NGC_ORG=nvidia
NGC_PULL_SECRET_NAME=ngc-pullsecret   # K8s Secret name; we'll create it in your namespace in Phase B

# --- Auth Token (JWT) ---
# OPTIONAL FOR LAPTOP-SIDE SCRIPTS ONLY.
# Inside Kubeflow notebooks / DAG pods / MLIS pods, $AUTH_TOKEN is auto-injected — leave blank here.
#
# Three ways to obtain (if needed for local CLI scripts):
#   A. From inside any Kubeflow notebook terminal: `echo $AUTH_TOKEN` (easiest, recommended)
#   B. From Chrome DevTools: Network tab → any PCAI API request → Authorization: Bearer <token>
#   C. Direct Grant via curl against keycloak.${PCAI_DOMAIN}/realms/UA/protocol/openid-connect/token
#
# Used as: AWS_ACCESS_KEY_ID for boto3 against local-s3 proxy, Bearer token for MLIS.
# Token expires periodically; re-generate as needed.
AUTH_TOKEN=
